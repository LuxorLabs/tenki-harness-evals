# Tenki: https://tenki.cloud/docs/account/api-keys
TENKI_API_KEY=tk_...
# Optional, from `uv run tenki-harbor prepare`; makes every trial start faster.
TENKI_HARBOR_SNAPSHOT_ID=

# Model endpoint, OpenAI-compatible (most harnesses).
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=sk-...

# Same endpoint, Anthropic Messages API (Claude Code). No /v1 suffix.
ANTHROPIC_BASE_URL=https://api.example.com
ANTHROPIC_API_KEY=sk-...
